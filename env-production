ALLOW_EDIT=true

BASE_DATA_DIRECTORY=/mnt/akwamodata
GITHUB_REPOSITORY_OWNER=mfn-berlin

#traefik
DOMAIN=localhost
SUB_PATH=/ecomon
ENTRY_PORT=80
PROTOCOL=http
TMP_DIR=/YOUR_TMP_DIR
USE_GPU=None
DB_WORKER_CONCURRENCY=16
INF_WORKER_CONCURRENCY=8

# Backup
PGBACKUP_PATH=/YOUR_BACKUP_DIRECTORY
BACKUP_CHUNK_SIZE=1G
MAX_BACKUPS=3

# .env.production - Production settings for 251GB RAM system

# PostgreSQL
DB_USERNAME=ecomon
DB_PASSWORD=YOUR_PASSWORD
DB_ROOT_PASSWORD=YOUR_PASSWORD
DB_HOST=db
DB_PORT=5432
DB_NAME=ecomon
PGDATA_PATH=YOUR_DATA_DIRECTORY/docker/data/volumes/akwamo-webservice-next_ecomon_data

# PostgreSQL Resource Limits
POSTGRES_MEMORY_LIMIT=32G
POSTGRES_CPU_LIMIT=8.0
POSTGRES_MEMORY_RESERVATION=16G
POSTGRES_CPU_RESERVATION=4.0

# PostgreSQL Performance Configuration
POSTGRES_SHM_SIZE=8G
POSTGRES_SHARED_BUFFERS=8GB
POSTGRES_EFFECTIVE_CACHE_SIZE=24GB
POSTGRES_MAINTENANCE_WORK_MEM=2GB
POSTGRES_WORK_MEM=256MB
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_WAL_BUFFERS=64MB
POSTGRES_DEFAULT_STATISTICS_TARGET=100
POSTGRES_RANDOM_PAGE_COST=1.1
POSTGRES_EFFECTIVE_IO_CONCURRENCY=200
POSTGRES_MIN_WAL_SIZE=2GB
POSTGRES_MAX_WAL_SIZE=8GB
POSTGRES_MAX_WORKER_PROCESSES=16
POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=8
POSTGRES_MAX_PARALLEL_WORKERS=16
POSTGRES_MAX_PARALLEL_MAINTENANCE_WORKERS=8
POSTGRES_MAX_CONNECTIONS=500
POSTGRES_HUGE_PAGES=try
POSTGRES_LOG_MIN_DURATION_STATEMENT=1000
POSTGRES_AUTOVACUUM_MAX_WORKERS=8
POSTGRES_AUTOVACUUM_WORK_MEM=2GB
POSTGRES_TEMP_BUFFERS=256MB
POSTGRES_CHECKPOINT_TIMEOUT=30min

# Hasura Configuration - Production
HASURA_ADMIN_SECRET=YOUR_SECRET
HASURA_WEBHOOKS_BASE_URL=http://api:80
HASURA_URL=172.17.0.1:10080/v1/graphql

HASURA_MEMORY_LIMIT=16G
HASURA_CPU_LIMIT=8.0
HASURA_MEMORY_RESERVATION=8G
HASURA_CPU_RESERVATION=4.0
HASURA_GRAPHQL_CONNECTIONS_PER_READ_REPLICA=100
HASURA_GRAPHQL_STRIPES_PER_READ_REPLICA=2
HASURA_GRAPHQL_POOL_TIMEOUT=600
HASURA_GRAPHQL_CONNECTION_LIFETIME=900
HASURA_GRAPHQL_LIVE_QUERIES_MULTIPLEXED_REFETCH_INTERVAL=1
HASURA_GRAPHQL_LIVE_QUERIES_MULTIPLEXED_BATCH_SIZE=200
HASURA_GRAPHQL_ENABLE_CONSOLE=false
HASURA_GRAPHQL_DEV_MODE=false
HASURA_GRAPHQL_READ_ONLY_MODE=false
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=user
HASURA_GRAPHQL_ENABLED_LOG_TYPES=startup,http-log

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_MEMORY_LIMIT=8G
REDIS_CPU_LIMIT=4.0
REDIS_MEMORY_RESERVATION=4G
REDIS_CPU_RESERVATION=2.0
REDIS_MAXMEMORY=6gb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_SAVE_INTERVAL=900
REDIS_SAVE_CHANGES=1
REDIS_APPENDONLY=yes
REDIS_APPENDFSYNC=everysec
REDIS_TCP_KEEPALIVE=300
REDIS_TIMEOUT=0
REDIS_TCP_BACKLOG=511

# Airflow
AIRFLOW_ADMIN_PASSWORD=YOUR_PASSWORD